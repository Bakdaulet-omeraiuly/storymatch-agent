# Copy to .env (or export these in your shell) before running.

# --- Model provider ---
# "bedrock" (default, what the hackathon rewards) or "anthropic" (fallback
# for local dev/demo while AWS Bedrock model access/billing is being sorted).
STORYMATCH_MODEL_PROVIDER=bedrock

# --- Bedrock (used when STORYMATCH_MODEL_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
STORYMATCH_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS credentials are picked up from ~/.aws/credentials (default profile) or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars -- not set here.

# --- Anthropic direct (used when STORYMATCH_MODEL_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
STORYMATCH_ANTHROPIC_MODEL_ID=claude-sonnet-4-5
